{
  "contract_type": "RuleDefinition",
  "contract_version": "1.0.0",
  "source_system": "vellum",
  "source_type": "native-rule-registry",
  "source_record_id": "trade_validation.large_trade_alert.v1",
  "payload": {
    "rule_id": "trade_validation.large_trade_alert",
    "rule_name": "Large trade alert",
    "rule_family": "trade_validation",
    "version": "1.0.0",
    "status": "active",
    "description": "Flags trades whose value exceeds $1,000,000 and requires approval. Ported from drools/custodian-banking-rules.drl \"Large Trade Alert\".",
    "determinism_class": "deterministic",
    "target_contract_types": ["Trade"],
    "expression_language": "jsonlogic",
    "predicate": {
      ">": [{ "var": "trade.trade_value" }, 1000000]
    },
    "severity": "high",
    "materiality": {
      "mode": "static",
      "value": "material"
    },
    "outcome": {
      "result_code": "LARGE_TRADE_ALERT",
      "result_type": "flag",
      "create_exception": false,
      "create_reconciliation_break": false,
      "open_workflow_case": false,
      "require_approval": true,
      "explanation_template": "Trade {{trade.trade_id}} value ${{trade.trade_value}} exceeds the $1,000,000 threshold and requires approval."
    },
    "evidence": {
      "fields": ["trade.trade_id", "trade.trade_value"]
    },
    "test_cases": [
      { "name": "trade value over $1M", "expected_result": "triggered" },
      { "name": "trade value under $1M", "expected_result": "not_triggered" }
    ],
    "tags": ["trade_validation", "deterministic"]
  }
}
