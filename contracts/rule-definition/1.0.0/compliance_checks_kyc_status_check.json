{
  "contract_type": "RuleDefinition",
  "contract_version": "1.0.0",
  "source_system": "vellum",
  "source_type": "native-rule-registry",
  "source_record_id": "compliance_checks.kyc_status_check.v1",
  "payload": {
    "rule_id": "compliance_checks.kyc_status_check",
    "rule_name": "KYC status check",
    "rule_family": "compliance_checks",
    "version": "1.0.0",
    "status": "active",
    "description": "Blocks trades for clients without approved KYC status. Ported from drools/custodian-banking-rules.drl \"KYC Status Check\".",
    "determinism_class": "deterministic",
    "target_contract_types": ["Trade", "Client"],
    "expression_language": "jsonlogic",
    "predicate": {
      "!=": [{ "var": "client.kyc_status" }, "APPROVED"]
    },
    "severity": "high",
    "materiality": {
      "mode": "static",
      "value": "material"
    },
    "outcome": {
      "result_code": "KYC_NOT_APPROVED",
      "result_type": "exception",
      "create_exception": true,
      "create_reconciliation_break": false,
      "open_workflow_case": true,
      "require_approval": false,
      "explanation_template": "Client {{client.client_id}} KYC status is {{client.kyc_status}} — trade {{trade.trade_id}} is blocked."
    },
    "evidence": {
      "fields": ["trade.trade_id", "client.client_id", "client.kyc_status"]
    },
    "test_cases": [
      { "name": "client KYC not approved", "expected_result": "triggered" },
      { "name": "client KYC approved", "expected_result": "not_triggered" }
    ],
    "tags": ["compliance_checks", "deterministic"]
  }
}
